# Runtime
NODE_ENV=development
APP_VERSION=local
SERVICE_NAME=seg-api
PORT=3000

# Required by the existing Manus auth and storage integration
VITE_APP_ID=replace-with-app-id
JWT_SECRET=replace-with-a-long-random-secret
OAUTH_SERVER_URL=https://oauth.manus.im
DATABASE_URL=mysql://user:password@host:3306/database
BUILT_IN_FORGE_API_URL=https://forge.manus.im
BUILT_IN_FORGE_API_KEY=replace-with-server-key
OWNER_OPEN_ID=
OWNER_NAME=

# Proxy and request hardening
TRUST_PROXY=false
BODY_SIZE_LIMIT=10mb
API_RATE_LIMIT=240
AUTH_RATE_LIMIT=30
REQUEST_TIMEOUT_MS=30000
KEEP_ALIVE_TIMEOUT_MS=5000
HEADERS_TIMEOUT_MS=6000

# Security policy
ENABLE_HSTS=false
HSTS_PRELOAD=false
DISABLE_CSP=false
CSP_UPGRADE_INSECURE_REQUESTS=false
DISABLE_PRECOMPRESSED_ASSETS=false

# Observability
LOG_REQUEST_HEADERS=false
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
